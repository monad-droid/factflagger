{
  "manifest_version": 3,
  "name": "FactFlag",
  "version": "0.5.12",
  "description": "Fact-checks YouTube videos and flags false claims at the moment they're said.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.tavily.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FactFlag"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content/overlay.css"
      ]
    }
  ]
}
